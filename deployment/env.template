# Settings for the card scanner on this Pi. Never overwritten by updates.

# Image version: 'latest' follows master, a version number such as 0.1.20 pins that version.
IMAGE_TAG=latest

# Host port of the web app and API.
APP_PORT=3030

# Address of the reverse proxy; only it may reach APP_PORT. Several: comma-separated.
# Empty means the port is open to the whole network; login with Google, when set below, still guards the app.
ALLOWED_SOURCE=

# Login with Google, and the Google Drive copy. Empty GOOGLE_CLIENT_ID switches both off: then only the
# reverse proxy guards the app. Client id and secret come from a Google Cloud OAuth client of type
# "web application" with two redirect addresses:
#   <PUBLIC_URL>/api/v1/auth/google/callback   (login)
#   <PUBLIC_URL>/api/v1/google/callback        (Google Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Address the site is reached at, without a slash at the end, such as https://cards.example.com
PUBLIC_URL=
# Google accounts that may log in, comma-separated. With login on and this empty, nobody can log in.
ALLOWED_EMAILS=
# The account that may connect Google Drive and start system actions. Empty: the first of ALLOWED_EMAILS.
OWNER_EMAIL=

# Folder in the owner's Google Drive that receives the photos, the sheet and the database copy.
DRIVE_FOLDER=Documents/~Hobby/Pokémon
# Name of the spreadsheet in that folder.
SHEET_NAME=Pokémon cards

# Reading photos with Claude. An empty key switches it off: cards are then picked by hand from the catalogue.
ANTHROPIC_API_KEY=
# The Claude model that reads the photos.
VISION_MODEL=claude-opus-5-5

# Content security policy: 'report' (default) only writes to the log what it would block,
# 'enforce' blocks it, 'off' sends no policy.
CSP_MODE=report
